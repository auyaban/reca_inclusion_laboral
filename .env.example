# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Variables de entorno de RECA Inclusión Laboral
#
# Copia este archivo como ".env" junto al ejecutable (o junto a app.py en dev)
# y rellena los valores. Las variables vacías usan el comportamiento por defecto.
# ─────────────────────────────────────────────────────────────────────────────


# ── Supabase ──────────────────────────────────────────────────────────────────
# URL base del proyecto Supabase (termina sin /)
SUPABASE_URL=

# API key anónima de Supabase (anon key, no la service_role)
SUPABASE_KEY=


# ── Google Sheets / Drive ─────────────────────────────────────────────────────
# Ruta al archivo service-account.json de Google.
# Si está vacío, la app lo busca automáticamente en:
#   1. %APPDATA%/RECA Inclusion Laboral/
#   2. Carpeta del ejecutable / directorio de trabajo
GOOGLE_SERVICE_ACCOUNT_FILE=

# ID del spreadsheet master que contiene todas las hojas de formularios.
# Se obtiene de la URL: docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEETS_DEFAULT_SPREADSHEET_ID=

# ID del spreadsheet plantilla para Evaluación de Accesibilidad.
# Se copia al crear un acta nueva de este formulario.
GOOGLE_SHEETS_EVALUACION_ACCESIBILIDAD_TEMPLATE_ID=

# ID del spreadsheet plantilla para Seguimientos.
# Cada caso nuevo se crea copiando esta plantilla en Drive.
GOOGLE_SHEETS_SEGUIMIENTOS_TEMPLATE_ID=

# ID del spreadsheet del Diccionario Oficial de discapacidades.
# Usado por Condiciones de Vacante. Si está vacío, usa fallback embebido en código.
GOOGLE_SHEETS_OFFICIAL_DICTIONARY_SPREADSHEET_ID=

# ID de la carpeta raíz en Google Drive donde viven todos los casos de Seguimientos.
# Debe ser un folder ID de Drive (no una URL completa).
SEGUIMIENTOS_SHARED_ROOT=


# ── Dictado de voz ────────────────────────────────────────────────────────────
# Nombre del Edge Function de Supabase que recibe audio y retorna transcripción.
DICTATION_FUNCTION_NAME=dictate-transcribe

# Idioma de transcripción para OpenAI Whisper (código BCP-47).
DICTATION_LANGUAGE=es


# ── Auto-actualización ────────────────────────────────────────────────────────
# Nombre exacto del asset installer en GitHub Releases.
INSTALLER_ASSET_NAME=RECA_INCLUSION_LABORAL_Setup.exe


# ── Desarrollo y QA ───────────────────────────────────────────────────────────
# Habilita el botón de relleno automático con datos de prueba en formularios.
# Solo funciona si el login activo está en RECA_TEST_FILL_LOGIN.
# Valores: 0 (desactivado) | 1 (activado)
RECA_ENABLE_TEST_FILL=0

# Login que tiene permiso para usar el test fill.
RECA_TEST_FILL_LOGIN=testaaron

# Logins separados por coma exentos del conteo de uso/licencia.
USAGE_EXEMPT_LOGINS=
